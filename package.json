    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.3.1",
    "eslint": "^9.20.0",
    "pg": "^8.23.1",
    "prettier": "^3.8.1",
    "sharp": "^0.35.5",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
