{
  "name": "raylesecret",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "vite build",
    "build": "vite build",
    "preview": "pnpm build && wrangler pages dev dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "db:seed": "tsx src/db/seed.ts",
    "images": "node scripts/prepare-images.mjs",
    "typecheck": "tsc --noEmit",
    "admin:password": "node scripts/set-admin-password.mjs",
    "deploy": "pnpm build && wrangler pages deploy dist --project-name raylesecret"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
