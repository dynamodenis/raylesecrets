# Neon Postgres connection string (use the "pooled" one from the Neon dashboard).
# It must be a Neon database: the site connects over HTTP.
# While this is empty the site shows the built-in catalogue from src/data/catalog.ts.
DATABASE_URL=

# Public address of the live site, used in link previews and the sitemap.
# Leave empty for local development.
SITE_URL=

# Written by `pnpm admin:password`. Do not fill these in by hand.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
