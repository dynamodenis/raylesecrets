{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Cloudflare Pages project this site deploys to.
  "name": "raylesecret",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // `pnpm build` copies these settings into dist/_worker.js/wrangler.json and
  // adds the output folder; that copy is what `wrangler pages deploy` reads.
  //
  // Secrets (DATABASE_URL, ADMIN_PASSWORD_HASH, SESSION_SECRET, SITE_URL) are
  // not kept here. The deploy workflow sends DATABASE_URL and SITE_URL to
  // Cloudflare from GitHub; the other two are set directly on the Pages project.
}
